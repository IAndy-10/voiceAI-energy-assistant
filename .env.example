# Copy to .env for local runs; on Fly.io set the secrets with `fly secrets set NAME=value`.
# Non-secret defaults for Fly live in fly.toml [env].

# Dashboard → server: typed once per session in the dashboard's "Sincronizar asistente" prompt
VOICE_PASSCODE=
SNAPSHOT_PATH=/data/agent_snapshot.json
# Comma-separated. "null" = dashboard opened from file://; add the hosted origin if you host it
CORS_ORIGINS=null

# Twilio
PUBLIC_HOST=multicentro-voz.fly.dev
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164, comma-separated: Pablo + backup phone
ALLOWED_CALLERS=+569XXXXXXXX,+569YYYYYYYY
# Only for local tests without Twilio; keep 1 in production
TWILIO_VALIDATE_SIGNATURE=1
MAX_CALL_SECS=600

# LLM (Claude Sonnet 5.5, chosen for latency)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# low | medium | high. low skips thinking on most simple turns
LLM_EFFORT=low
# adaptive (default) | between_tools (lowest thinking setting, if latency is still too high)
LLM_THINKING=adaptive
LLM_MAX_TOKENS=1024
# Server-side fallback to another model on a safety decline
LLM_SERVER_FALLBACK=1

# Speech: pick the combination after the Monday test (spec §7.4)
# deepgram | azure
STT_PROVIDER=deepgram
# azure | elevenlabs
TTS_PROVIDER=azure
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3-general
# 1 = boost store names (check that Deepgram accepts keyterms for Spanish before relying on it)
DEEPGRAM_KEYTERMS=0
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# or es-CL-LorenzoNeural
AZURE_TTS_VOICE=es-CL-CatalinaNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
