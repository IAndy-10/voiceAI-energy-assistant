# Use a unique local value. Do not commit a populated .env file.
ENERGY_TOOLS_API_TOKEN=change-this-local-demo-token
# OpenAI remains off until explicitly enabled. Keep OPENAI_API_KEY only in your local .env or shell.
OPENAI_ENABLED=false
OPENAI_MODEL=gpt-6-luna
OPENAI_BUDGET_USD=2.00
OPENAI_MAX_QUERIES=20
OPENAI_MAX_OUTPUT_TOKENS=300
OPENAI_MAX_INPUT_TOKENS=4000
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_TOOL_ROUNDS=2
OPENAI_MAX_TOOL_CALLS=6
OPENAI_RESERVE_USD=0.10
# Verified gpt-6-luna standard text rates per 1M tokens; set both explicitly for another model.
OPENAI_INPUT_USD_PER_MILLION=0.10
OPENAI_OUTPUT_USD_PER_MILLION=0.50
# SHA-256 canonical JSON of the approved fictitious dataset only; this is not a client-data hash.
VESTA_DEMO_SNAPSHOT_SHA256=4fb95b36721ba61d7f8221b2b686b9a8ea731267078025059eba78433aa06882
SNAPSHOT_MAX_BYTES=5242880

# Voice UI: the backend selects the provider. No provider key belongs here.
VOICE_ENABLED=true
VOICE_AGENT_ENABLED=false
VOICE_PROVIDER=pipecat
VOICE_PIPECAT_URL=http://127.0.0.1:7860
# Used only by energy-api to probe runner HTTP. Keep it internal for Docker.
VOICE_RUNNER_HEALTH_URL=http://voice-agent:7860
VOICE_MAX_RECORDING_SECONDS=30
# Server-side ceiling for the billable STT → LLM → TTS pipeline. It stays off by
# default. When true, a user may opt in for one authenticated voice session from
# the UI; this never follows OPENAI_ENABLED and does not restart the runner.
VOICE_PIPELINE_ENABLED=false
VOICE_STT_MODEL=gpt-transcribe
# Defaults to OPENAI_MODEL when unset.
# VOICE_LLM_MODEL=gpt-6-luna
VOICE_LLM_MAX_TOKENS=300
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=alloy
# Tool calls per session, and session limits in seconds.
VOICE_MAX_TURNS=8
VOICE_TOOL_TIMEOUT_SECONDS=10
VOICE_IDLE_TIMEOUT_SECONDS=45
VOICE_SESSION_MAX_SECONDS=300
# Conservative reservation charged even if a provider request fails.
VOICE_SESSION_BUDGET_USD=0.20
VOICE_BUDGET_USD=2.00
VOICE_MAX_SESSIONS=10
# Used by a local Windows runner. The container uses its own mounted path.
VOICE_USAGE_FILE=data/voice-usage.json
# Local TURN relay for WebRTC on Docker Desktop. Generate with: openssl rand -hex 32
TURN_SHARED_SECRET=change-this-local-turn-secret
